PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
MONGODB_URI=mongodb://127.0.0.1:27017/travelio

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=Travelio <your-email@gmail.com>

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# PayOS (https://payos.vn). Webhook URL to register: https://<your-domain>/api/payments/payos/webhook
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Optional. Defaults to the production PayOS API.
PAYOS_API_URL=https://api-merchant.payos.vn
# Optional. Default is <FRONTEND_URL>/my-trips/<bookingId>?payment=return|cancel. Use {bookingId} as a placeholder.
PAYOS_RETURN_URL=http://localhost:5173/my-trips/{bookingId}?payment=return
PAYOS_CANCEL_URL=http://localhost:5173/my-trips/{bookingId}?payment=cancel
# Public tunnel address used by scripts/register-payos-webhook.cjs (changes every time a free tunnel restarts).
PAYOS_WEBHOOK_URL=https://TEN-MIEN-TUNNEL/api/payments/payos/webhook
# Where PayOS sends the customer after paying or cancelling.
FRONTEND_URL=http://localhost:5173
