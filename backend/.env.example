PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
MONGODB_URI=mongodb://127.0.0.1:27017/travelio

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=Travelio <your-email@gmail.com>

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# SePay (VietQR). Webhook URL: https://<your-domain>/api/payments/sepay/webhook
# Configure the payment-code prefix in SePay as TVL (booking codes look like TVL-XXXXXXXXXXXXXXXX).
SEPAY_API_KEY=
SEPAY_BANK_NAME=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
