erDiagram
    ROLES ||--o{ USERS : "role_id"
    USERS ||--o| USER_PROFILES : "user_id"
    USERS ||--o{ FACILITIES : "vendor_id"
    USERS ||--o{ BOOKINGS : "customer_id (nullable)"
    USERS ||--o{ BOOKINGS : "decided_by (nullable)"
    USERS ||--o{ REVIEWS : "customer_id"
    USERS ||--o{ LOYALTY_POINT_TRANSACTIONS : "user_id"
    USERS ||--o{ SUPPORT_TICKETS : "created_by"
    USERS ||--o{ SUPPORT_TICKETS : "assigned_manager_id (nullable)"
    USERS ||--o{ NOTIFICATIONS : "user_id"
    USERS ||--o{ PAYOUTS : "vendor_id"
    USERS ||--o{ PAYOUTS : "manager_id (nullable)"
    USERS ||--o{ AUDIT_LOGS : "user_id (nullable)"

    FACILITIES ||--o{ FACILITY_IMAGES : "facility_id"
    FACILITIES ||--o{ FACILITY_AMENITIES : "facility_id"
    AMENITIES ||--o{ FACILITY_AMENITIES : "amenity_id"
    FACILITIES ||--o{ SERVICES : "facility_id"
    FACILITIES ||--o{ REVIEWS : "facility_id"

    SERVICES ||--o{ SERVICE_INVENTORY : "service_id"

    PROMOTIONS ||--o{ BOOKINGS : "promotion_id (nullable)"
    BOOKINGS ||--o{ BOOKING_DETAILS : "booking_id"
    BOOKINGS ||--o{ PAYMENTS : "booking_id"
    BOOKINGS ||--o| REVIEWS : "booking_id"
    BOOKINGS ||--o{ LOYALTY_POINT_TRANSACTIONS : "booking_id (nullable)"
    BOOKINGS ||--o{ SUPPORT_TICKETS : "booking_id"

    SERVICE_INVENTORY ||--o{ BOOKING_DETAILS : "inventory_id"

    PAYOUTS ||--o{ PAYOUT_DETAILS : "payout_id"
    BOOKING_DETAILS ||--o| PAYOUT_DETAILS : "booking_detail_id"

    ROLES {
        int id PK
        varchar role_name
        varchar description
    }

    USERS {
        bigint id PK
        varchar email
        varchar password_hash
        varchar full_name
        varchar phone
        int role_id FK
        int total_loyalty_points
        enum status
        timestamp created_at
        timestamp updated_at
    }

    USER_PROFILES {
        bigint user_id PK, FK
        varchar avatar_url
        json payment_methods
        json preferences
    }

    FACILITIES {
        bigint id PK
        bigint vendor_id FK
        enum type
        varchar name
        text address
        varchar city
        text description
        decimal commission_rate
        enum status
        timestamp created_at
    }

    FACILITY_IMAGES {
        bigint id PK
        bigint facility_id FK
        varchar image_url
        boolean is_primary
    }

    AMENITIES {
        int id PK
        varchar name
        varchar icon_url
        enum type
    }

    FACILITY_AMENITIES {
        bigint facility_id PK, FK
        int amenity_id PK, FK
    }

    SERVICES {
        bigint id PK
        bigint facility_id FK
        enum type
        varchar name
        text description
        int capacity
        decimal base_price
    }

    SERVICE_INVENTORY {
        bigint id PK
        bigint service_id FK
        date target_date
        time time_slot
        int available_qty
        decimal price
    }

    PROMOTIONS {
        bigint id PK
        varchar code
        enum discount_type
        decimal discount_value
        decimal max_discount
        datetime valid_from
        datetime valid_to
        int usage_limit
        enum status
    }

    BOOKINGS {
        bigint id PK
        varchar booking_code
        bigint customer_id FK
        varchar guest_name
        varchar guest_email
        varchar guest_phone
        bigint promotion_id FK
        decimal total_amount
        decimal final_amount
        enum status
        bigint decided_by FK
        varchar decision_note
        timestamp decided_at
        timestamp created_at
    }

    BOOKING_DETAILS {
        bigint id PK
        bigint booking_id FK
        bigint inventory_id FK
        int quantity
        decimal unit_price
        decimal commission_rate
        decimal commission_amount
        varchar qr_code
        enum check_in_status
    }

    PAYMENTS {
        bigint id PK
        bigint booking_id FK
        varchar transaction_id
        enum payment_gateway
        decimal amount
        enum status
        timestamp payment_date
    }

    REVIEWS {
        bigint id PK
        bigint booking_id FK
        bigint facility_id FK
        bigint customer_id FK
        int rating
        text comment
        text vendor_reply
        timestamp created_at
    }

    LOYALTY_POINT_TRANSACTIONS {
        bigint id PK
        bigint user_id FK
        bigint booking_id FK
        int points
        varchar reason
        timestamp created_at
    }

    SUPPORT_TICKETS {
        bigint id PK
        bigint booking_id FK
        bigint created_by FK
        bigint assigned_manager_id FK
        enum issue_type
        text description
        enum status
        timestamp created_at
        timestamp updated_at
    }

    NOTIFICATIONS {
        bigint id PK
        bigint user_id FK
        varchar title
        text message
        enum type
        boolean is_read
        timestamp created_at
    }

    PAYOUTS {
        bigint id PK
        bigint vendor_id FK
        bigint manager_id FK
        decimal amount
        enum status
        date period_start
        date period_end
        timestamp created_at
    }

    PAYOUT_DETAILS {
        bigint id PK
        bigint payout_id FK
        bigint booking_detail_id FK
        decimal amount
    }

    SYSTEM_CONFIGS {
        varchar config_key PK
        text config_value
        varchar description
        timestamp updated_at
    }

    AUDIT_LOGS {
        bigint id PK
        bigint user_id FK
        varchar action
        varchar table_name
        bigint record_id
        json old_data
        json new_data
        timestamp created_at
    }
