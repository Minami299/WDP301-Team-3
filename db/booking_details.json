{
  "collection": "booking_details",
  "relationships": {
    "references": [
      { "field": "booking_id", "refers_to": "bookings._id" },
      { "field": "inventory_id", "refers_to": "service_inventory._id" }
    ],
    "referenced_by": [
      "payout_details.booking_detail_id"
    ]
  },
  "schema": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "properties": {
          "booking_id": { "bsonType": "objectId" },
          "inventory_id": { "bsonType": "objectId" },
          "quantity": { "bsonType": ["int", "long"], "exclusiveMinimum": 0 },
          "unit_price": { "bsonType": ["double", "decimal", "int", "long"], "minimum": 0 },
          "commission_rate": { "bsonType": ["double", "decimal", "int", "long"], "minimum": 0, "maximum": 100 },
          "commission_amount": { "bsonType": ["double", "decimal", "int", "long"], "minimum": 0 },
          "qr_code": { "bsonType": ["string", "null"] },
          "check_in_status": { "enum": ["PENDING", "CHECKED_IN", "NO_SHOW"] }
        }
      }
    },
    "indexes": [
      { "key": { "booking_id": 1 } },
      { "key": { "inventory_id": 1 } },
      { "key": { "qr_code": 1 }, "unique": true, "sparse": true }
    ]
  }
}